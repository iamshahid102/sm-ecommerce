{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "scripts/**/*.js",
    "tests/**/*.js",
    "*.js",
    "*.cjs"
  ],
  "exclude": ["node_modules", "coverage"]
}
