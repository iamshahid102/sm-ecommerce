# SM Store API - environment variables
# Copy this file to backend/.env and fill in the values.
# Never commit backend/.env or any real secret.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Allowed browser origin used by the Next.js app. No trailing slash.
FRONTEND_URL=http://localhost:3000
# Additional comma-separated origins (for example apex + www). No trailing slash.
# FRONTEND_URLS=https://www.example.com,https://example.com

# Supabase (server only - never expose these in the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used to verify customer access tokens (anon/publishable key)
SUPABASE_ANON_KEY=

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM=SM Store <orders@example.com>

# Stripe card payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used only by scripts/seed-admin.js (Phase 1)
ADMIN_EMAIL=
ADMIN_PASSWORD=
